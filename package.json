{
  "name": "dogokit-akita",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "dev": "vp run @dogokit/web#dev",
    "ready": "vp run check && vp run -r test && vp run -r build",
    "check": "vp check --deny-warnings && vp run lint:md",
    "check:links": "git ls-files -co --exclude-standard -z '*.md' ':!.claude' | xargs -0 linkinator --markdown --timeout 15000",
    "fix": "vp check --fix",
    "format": "vp fmt",
    "lint": "vp lint --deny-warnings",
    "lint:md": "markdownlint \"**/*.md\" --dot",
    "test": "echo 'test'",
    "test:unit": "echo 'test:unit'",
    "test:e2e": "echo 'test:e2e'",
    "upgrade": "taze -w && taze major -w",
    "ui": "shadcn",
    "outdated": "taze",
    "gen:secret": "openssl rand -base64 32",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f postgres",
    "infra:reset": "docker compose down -v",
    "infra:test:up": "docker compose -f docker-compose.yml -f docker-compose.ephemeral.yml up -d --wait",
    "infra:test:down": "docker compose -f docker-compose.yml -f docker-compose.ephemeral.yml down -v",
    "infra:test:logs": "docker compose -f docker-compose.yml -f docker-compose.ephemeral.yml logs postgres",
    "infra:test:port": "docker compose -f docker-compose.yml -f docker-compose.ephemeral.yml port postgres 5432 | cut -d: -f2",
    "infra:server:config": "API_ENV_FILE=.env.example docker compose --env-file .env.example -f docker-compose.server.yml config --quiet"
  },
  "devDependencies": {
    "@types/bun": "1.4.5",
    "linkinator": "^8.1.0",
    "markdownlint": "^0.42.2",
    "markdownlint-cli": "^0.50.0",
    "modern-web-guidance": "^1.0.2",
    "shadcn": "^4.23.1",
    "taze": "^21.3.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8001",
    "vite-plus": "1.8.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8001"
  },
  "packageManager": "bun@1.4.5"
}
