{
  "name": "dogokit-akita",
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "check": "bun run format:check && bun run lint && bun run lint:md",
    "setup-db": "docker compose up -d",
    "test:infra:up": "docker compose -f docker-compose.yml -f docker-compose.test.yml up -d --wait",
    "test:infra:down": "docker compose -f docker-compose.yml -f docker-compose.test.yml down -v",
    "generate-secret": "openssl rand -base64 32",
    "check-links": "bunx linkinator *.md --markdown --retry-errors",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings .",
    "lint:md": "markdownlint \"**/*.md\" --dot"
  },
  "devDependencies": {
    "@types/bun": "1.4.5",
    "markdownlint": "^0.42.2",
    "markdownlint-cli": "^0.50.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
