{
  "name": "dogokit-akita",
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "check": "bun run format:check && bun run lint && bun run lint:md",
    "check:links": "linkinator *.md --markdown --retry-errors",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "generate:secret": "openssl rand -base64 32",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f postgres",
    "infra:reset": "docker compose down -v",
    "infra:up": "docker compose up -d --wait",
    "lint": "oxlint --deny-warnings .",
    "lint:md": "markdownlint \"**/*.md\" --dot",
    "server:config": "API_ENV_FILE=.env.example docker compose --env-file .env.example -f docker-compose.server.yml config --quiet",
    "test:infra:down": "docker compose -f docker-compose.yml -f docker-compose.ephemeral.yml down -v",
    "test:infra:logs": "docker compose -f docker-compose.yml -f docker-compose.ephemeral.yml logs postgres",
    "test:infra:port": "docker compose -f docker-compose.yml -f docker-compose.ephemeral.yml port postgres 5432",
    "test:infra:up": "docker compose -f docker-compose.yml -f docker-compose.ephemeral.yml up -d --wait"
  },
  "devDependencies": {
    "@types/bun": "1.4.5",
    "linkinator": "^8.1.0",
    "markdownlint": "^0.42.2",
    "markdownlint-cli": "^0.50.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
