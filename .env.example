# Database URL
# Local development: 127.0.0.1 is your own machine. Use the same port as POSTGRES_HOST_PORT
# On a server (docker-compose.server.yml), the api runs in a container, where 127.0.0.1 is the
# container itself. Use the service name instead: postgresql://<user>:<password>@postgres:5432/<db>
DATABASE_URL="postgresql://change_user:change_password@127.0.0.1:5432/change_db"

# General
DB_USER="change_user"
DB_PASSWORD="change_password"
DB_NAME="change_db"

# Postgres-specific
POSTGRES_USER="change_user"
POSTGRES_PASSWORD="change_password"
POSTGRES_DB="change_db"
POSTGRES_HOST_PORT="5432"

# MySQL-specific
MYSQL_USER="change_user"
MYSQL_PASSWORD="change_password"
MYSQL_DATABASE="change_db"
MYSQL_ROOT_PASSWORD="change_password"
MYSQL_HOST_PORT="3306"
